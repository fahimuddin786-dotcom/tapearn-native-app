            if (response.ok) {
                const data = await response.json();
                return {
                    success: true,
                    status: 'online',
                    responseTime: endTime - startTime,
                    data: data
                };
            } else {
                return {
                    success: false,
                    status: 'error',
                    responseTime: endTime - startTime
                };
            }
        } catch (error) {
            return {
                success: false,
                status: 'offline',
