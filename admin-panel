    syncToServer: async function() {
        try {
            const registeredUsers = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
            const sponsorData = {
                sponsorAssignments: registeredUsers.map(u => ({
                    userId: u.email || u.id,
                    sponsorId: u.sponsorId
