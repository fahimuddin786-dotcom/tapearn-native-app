    // Get real-time statistics WITH SPONSOR STATS
    getStats: function() {
        const users = window.adminData.users || [];
        const transactions = window.adminData.transactions || [];
        const sponsorStats = window.adminData.sponsorStats || {};
        
        // Calculate sponsor-specific stats
        const usersWithSponsor = users.filter(u => 
            u.sponsorId && u.sponsorId !== 'none' && u.sponsorId !== ''
        );
        const uniqueSponsors = [...new Set(usersWithSponsor.map(u => u.sponsorId))];
        
        const commissionEarnings = transactions
            .filter(tx => tx.category === 'referral' && tx.type === 'earning')
            .reduce((sum, tx) => sum + (tx.amount || 0), 0);
        
        const topSponsors = this.getTopSponsors(users);
        
        return {
            // User stats
            totalUsers: users.length,
            activeUsers: users.filter(u => u.status === 'active').length,
            verifiedUsers: users.filter(u => u.emailVerified).length,
            
            // Points and wallet stats
            totalPoints: users.reduce((sum, user) => sum + (user.points || 0), 0),
            totalUSDT: users.reduce((sum, user) => sum + (user.usdtWallet || 0), 0),
            
            // Transaction stats
            totalTransactions: transactions.length,
            earningTransactions: transactions.filter(t => t.type === 'earning').length,
            spendingTransactions: transactions.filter(t => t.type === 'spending').length,
            
            // Sponsor stats
            totalSponsors: uniqueSponsors.length,
            sponsoredUsers: usersWithSponsor.length,
            sponsorConversionRate: users.length > 0 ? 
                ((usersWithSponsor.length / users.length) * 100).toFixed(1) : 0,
            commissionEarnings: commissionEarnings,
            topSponsors: topSponsors,
            
            // Registration stats
            todayRegistrations: users.filter(user => {
                const regDate = new Date(user.registration_date || user.registeredAt);
                return regDate.toDateString() === new Date().toDateString();
            }).length,
            
            // Server status
            serverConnected: window.adminData.serverConnected || false,
            lastUpdated: window.adminData.lastUpdated,
            sponsorStats: sponsorStats
        };
