    getSponsorHierarchy: function(sponsorId) {
        const users = window.adminData.users || [];
        const sponsorMap = {};
        
        // Create sponsor map
        users.forEach(user => {
            if (user.sponsorId && user.sponsorId !== 'none' && user.sponsorId !== '') {
                if (!sponsorMap[user.sponsorId]) {
                    sponsorMap[user.sponsorId] = [];
                }
                sponsorMap[user.sponsorId].push(user);
            }
        });
        
        // Get specific sponsor hierarchy
        const getHierarchy = (sponsorId, level = 0, maxLevel = 3) => {
            if (level >= maxLevel) return null;
            
            const sponsoredUsers = sponsorMap[sponsorId] || [];
            const hierarchy = {
                sponsorId,
                sponsorData: users.find(u => u.email === sponsorId || u.id === sponsorId),
                level,
                sponsoredUsers: sponsoredUsers.map(user => ({
                    userId: user.email || user.id,
                    userData: user,
                    children: getHierarchy(user.email || user.id, level + 1, maxLevel)
                }))
            };
            
            return hierarchy;
        };
        
        return getHierarchy(sponsorId);
    },

