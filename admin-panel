    // Filter deleted users
    filterDeletedUsers: function(users) {
        // Get deleted users from localStorage
        const deletedUsers = JSON.parse(localStorage.getItem('deletedUsers') || '[]');
        const deletedUsersSet = new Set(deletedUsers.map(id => id?.toString()?.toLowerCase()));
        
        return users.filter(user => {
            const userIdentifiers = [
                user.email,
                user.id?.toString(),
                user.username,
                user.email?.toLowerCase(),
                user.username?.toLowerCase()
            ].filter(Boolean);
            
            return !userIdentifiers.some(id => 
                deletedUsersSet.has(id?.toString()?.toLowerCase())
            );
        });
    },

