// admin-panel.js - Admin Panel Helper Functions (OPTIMIZED VERSION WITH MOBILE SUPPORT)

// Auto-detect current server and use universal endpoints
const getServerBase = () => {
    // Try to detect current server
    const currentHost = window.location.hostname;
    const isLocalhost = currentHost === 'localhost' || currentHost === '127.0.0.1';
    
    if (isLocalhost) {
        return 'http://localhost:3000';
    } else {
        // For production/deployed versions
        return window.location.origin || 'https://tapearn-native-app.onrender.com';
    }
};

const SERVER_BASE = getServerBase();
console.log(`🚀 Admin Panel connected to: ${SERVER_BASE}`);

const AdminPanel = {
    // Dynamic endpoints based on current server
    endpoints: {
        getUsers: `${SERVER_BASE}/api/get-all-users`,
        getTransactions: `${SERVER_BASE}/api/get-all-transactions`,
        getUserStats: `${SERVER_BASE}/api/admin/user-stats`,
        deleteUser: `${SERVER_BASE}/api/delete-user/`,
        syncUsers: `${SERVER_BASE}/api/admin/sync-all`,
        fixDatabase: `${SERVER_BASE}/api/admin/fix-database`,
        health: `${SERVER_BASE}/api/health`,
        databaseInfo: `${SERVER_BASE}/api/admin/database-info`,
        sponsorStats: `${SERVER_BASE}/api/admin/sponsor-stats`,
        realtimeSync: `${SERVER_BASE}/api/admin/realtime-sync`,
        assignSponsor: `${SERVER_BASE}/api/assign-sponsor`,
        removeSponsor: `${SERVER_BASE}/api/remove-sponsor`,
        bulkAssignSponsors: `${SERVER_BASE}/api/bulk-assign-sponsors`,
        updateUser: `${SERVER_BASE}/api/update-user/`,
        addPoints: `${SERVER_BASE}/api/add-points`,
        userSyncCheck: `${SERVER_BASE}/api/admin/user-sync-check`,
        mobileUsers: `${SERVER_BASE}/api/admin/mobile-users`,
        syncMobileUsers: `${SERVER_BASE}/api/admin/sync-mobile-users`
    },

    // Real-time refresh settings (OPTIMIZED)
    refreshInterval: 30000, // 30 seconds (optimized from 5s)
    autoRefreshEnabled: true,
    refreshTimer: null,
    syncStatusTimer: null,
    lastRefreshTime: 0,
    isRefreshing: false,
    refreshQueue: [],

    // Multi-server configuration
    servers: [
        { name: 'Local', url: 'http://localhost:3000', active: true },
        { name: 'Online', url: 'https://tapearn-native-app.onrender.com', active: true }
    ],

    // Performance monitoring
    perfMetrics: {
        loadTimes: [],
        refreshCount: 0,
        notificationCount: 0
    },

    // Mobile users tracking
    mobileUsersData: {
        count: 0,
        lastSync: null,
        analytics: {}
    },

    // Initialize admin panel
    init: async function() {
        console.log('🔧 Initializing OPTIMIZED Admin Panel with Mobile Support...');
        console.log(`📡 Server Base: ${SERVER_BASE}`);
        
        // Check authentication
        if (!this.checkAuth()) {
            window.location.href = 'index.html';
            return;
        }

        // Load initial data
        await this.loadInitialData();
        
        // Setup optimized real-time updates
        this.setupOptimizedRealTimeUpdates();
        
        // Inject admin controls if on main app
        if (window.location.pathname.includes('index.html')) {
            this.injectAdminControls();
        }
        
        // Initialize sponsor system
        this.initializeSponsorSystem();
        
        // Add real-time UI controls if on admin page
        if (window.location.pathname.includes('admin.html')) {
            setTimeout(() => {
                this.addRealTimeControls();
                this.addSyncControls();
                this.addServerStatusDisplay();
                this.setupSyncStatusDisplay();
                // Add sync controls to header
                this.addSyncControlsToHeader();
                // Add Mobile Users tab to navigation
                this.addMobileUsersToNav();
            }, 1000);
        }
        
        // Setup mobile user listener
        this.setupMobileUserListener();
        
        console.log('✅ OPTIMIZED Admin Panel with Mobile Support Initialized');
    },

    // Check admin authentication
    checkAuth: function() {
        const currentUser = JSON.parse(localStorage.getItem('currentUser') || '{}');
        const ADMIN_AUTHORIZED_USERS = [
            'admin@tapearn.com',
            'admin@example.com',
            'superuser@tapearn.com',
            'system_admin',
            'developer',
            'test@tapearn.com'
        ];

        if (!currentUser.email || !ADMIN_AUTHORIZED_USERS.includes(currentUser.email)) {
            console.log('🚫 Unauthorized admin access attempt by:', currentUser.email);
            return false;
        }

        return true;
    },

    // Load initial data from server (OPTIMIZED)
    loadInitialData: async function(force = false) {
        const now = Date.now();
        const timeSinceLastRefresh = now - this.lastRefreshTime;
        
        // Rate limiting
        if (!force && timeSinceLastRefresh < 10000) { // 10 seconds minimum
            console.log('⏳ Skipping refresh (rate limited)');
            return;
        }
        
        // Check if already refreshing
        if (this.isRefreshing) {
            console.log('⏳ Already refreshing, queueing request');
            if (!this.refreshQueue.includes('loadInitialData')) {
                this.refreshQueue.push('loadInitialData');
            }
            return;
        }
        
        this.isRefreshing = true;
        this.lastRefreshTime = now;
        const startTime = performance.now();
        
        try {
            console.log('📥 OPTIMIZED: Loading data from server...');
            
            // Check server health first
            const healthCheck = await this.testServerConnection();
            if (!healthCheck.success) {
                console.warn('⚠️ Server not responding, using local data');
                this.loadFromLocalStorage();
                return;
            }
            
            // Parallel fetching with error handling
            const [usersResponse, txResponse, statsResponse] = await Promise.allSettled([
                fetch(this.endpoints.getUsers).catch(() => ({ ok: false })),
                fetch(this.endpoints.getTransactions).catch(() => ({ ok: false })),
                fetch(this.endpoints.getUserStats).catch(() => ({ ok: false }))
            ]);
            
            // Process users
            if (usersResponse.status === 'fulfilled' && usersResponse.value.ok) {
                const data = await usersResponse.value.json();
                if (data.success) {
                    window.adminData = window.adminData || {};
                    const filteredUsers = this.filterDeletedUsers(data.users || data.data || []);
                    const userCountChanged = filteredUsers.length !== (window.adminData.users?.length || 0);
                    
                    window.adminData.users = filteredUsers;
                    
                    // Update mobile users count
                    this.updateMobileUserCount();
                    
                    // Show notification only if significant change
                    if (userCountChanged && Math.abs(filteredUsers.length - (window.adminData.users?.length || 0)) > 5) {
                        this.showNotification(`🔄 Users updated: ${filteredUsers.length} total`, 'info');
                    }
                }
            }

            // Process transactions
            if (txResponse.status === 'fulfilled' && txResponse.value.ok) {
                const data = await txResponse.value.json();
                if (data.success) {
                    window.adminData.transactions = data.transactions || data.data || [];
                }
            }

            // Process stats
            if (statsResponse.status === 'fulfilled' && statsResponse.value.ok) {
                const data = await statsResponse.value.json();
                if (data.success) {
                    window.adminData.serverStats = data.stats || data.data || {};
                }
            }

            // Load sponsor statistics
            await this.loadSponsorStats();
            
            // Load mobile users data
            await this.loadMobileUsersData();

            window.adminData.lastUpdated = new Date();
            window.adminData.serverConnected = true;
            
            // Update UI timestamp
            this.updateLastSyncTimestamp();
            
            // Dispatch event for UI updates
            this.dispatchEvent('adminDataLoaded', window.adminData);
            
            // Performance monitoring
            const endTime = performance.now();
            this.perfMetrics.loadTimes.push(endTime - startTime);
            this.perfMetrics.refreshCount++;
            
            // Keep only last 10 measurements
            if (this.perfMetrics.loadTimes.length > 10) {
                this.perfMetrics.loadTimes.shift();
            }
            
            // Log performance every 10 refreshes
            if (this.perfMetrics.refreshCount % 10 === 0) {
                const avgLoadTime = this.perfMetrics.loadTimes.reduce((a, b) => a + b, 0) / this.perfMetrics.loadTimes.length;
                console.log(`📊 Performance: Avg load ${avgLoadTime.toFixed(2)}ms, ${this.perfMetrics.refreshCount} refreshes`);
            }
            
            if (!force) {
                this.showNotification('✅ Data refreshed', 'success');
            }
            
        } catch (error) {
            console.error('❌ Error loading admin data:', error);
            this.showNotification('⚠️ Using local data (server offline)', 'warning');
            this.loadFromLocalStorage();
        } finally {
            this.isRefreshing = false;
            
            // Process queued refreshes
            if (this.refreshQueue.length > 0) {
                const nextRefresh = this.refreshQueue.shift();
                setTimeout(() => this.loadInitialData(), 5000);
            }
        }
    },

    // Load mobile users data
    loadMobileUsersData: async function() {
        try {
            const response = await fetch(this.endpoints.mobileUsers);
            if (response.ok) {
                const data = await response.json();
                if (data.success) {
                    this.mobileUsersData = {
                        count: data.count || 0,
                        lastSync: data.lastSync || new Date().toISOString(),
                        analytics: data.analytics || {},
                        mobileUsers: data.mobileUsers || []
                    };
                    console.log(`📱 Loaded ${this.mobileUsersData.count} mobile users`);
                }
            }
        } catch (error) {
            console.error('Error loading mobile users data:', error);
            this.calculateMobileUsersFromLocal();
        }
    },

    // Calculate mobile users from local data
    calculateMobileUsersFromLocal: function() {
        const users = window.adminData.users || [];
        const mobileUsers = users.filter(user => 
            user.source === 'mobile_app' || 
            user.source === 'mobile_server' ||
            user.device_type === 'mobile' ||
            user.platform === 'mobile'
        );
        
        this.mobileUsersData = {
            count: mobileUsers.length,
            lastSync: new Date().toISOString(),
            analytics: this.getMobileAnalytics(mobileUsers),
            mobileUsers: mobileUsers
        };
    },

    // Get mobile analytics
    getMobileAnalytics: function(mobileUsers) {
        const today = new Date();
        const weekAgo = new Date();
        weekAgo.setDate(weekAgo.getDate() - 7);
        
        const recentUsers = mobileUsers.filter(user => {
            const regDate = new Date(user.registration_date || user.registeredAt);
            return regDate >= weekAgo;
        });
        
        const todayUsers = mobileUsers.filter(user => {
            const regDate = new Date(user.registration_date || user.registeredAt);
            return regDate.toDateString() === today.toDateString();
        });
        
        const mobileOnlyUsers = mobileUsers.filter(u => !u.email && u.mobile);
        
        return {
            total: mobileUsers.length,
            recent: recentUsers.length,
            today: todayUsers.length,
            mobileOnly: mobileOnlyUsers.length,
            avgPoints: mobileUsers.length > 0 ? 
                Math.round(mobileUsers.reduce((sum, user) => sum + (user.points || 0), 0) / mobileUsers.length) : 0,
            deviceTypes: this.getDeviceTypes(mobileUsers),
            sources: this.getMobileSources(mobileUsers)
        };
    },

    // Get device types
    getDeviceTypes: function(mobileUsers) {
        const types = {};
        mobileUsers.forEach(user => {
            const type = user.device_type || 'unknown';
            types[type] = (types[type] || 0) + 1;
        });
        return types;
    },

    // Get mobile sources
    getMobileSources: function(mobileUsers) {
        const sources = {};
        mobileUsers.forEach(user => {
            const source = user.source || 'unknown';
            sources[source] = (sources[source] || 0) + 1;
        });
        return sources;
    },

    // Update mobile user count
    updateMobileUserCount: function() {
        const mobileUsers = (window.adminData.users || []).filter(user => 
            user.source === 'mobile_app' || 
            user.source === 'mobile_server' ||
            user.device_type === 'mobile' ||
            user.platform === 'mobile'
        );
        
        this.mobileUsersData.count = mobileUsers.length;
        
        // Update badge if exists
        const badge = document.getElementById('mobileUserCountBadge');
        if (badge) {
            badge.textContent = mobileUsers.length;
        }
    },

    // Load sponsor statistics
    loadSponsorStats: async function() {
        try {
            const response = await fetch(this.endpoints.sponsorStats);
            if (response.ok) {
                const data = await response.json();
                if (data.success) {
                    window.adminData.sponsorStats = data.stats || data.data || {};
                    console.log('✅ Sponsor stats loaded');
                }
            }
        } catch (error) {
            console.error('Error loading sponsor stats:', error);
            // Fallback: calculate from local data
            this.calculateLocalSponsorStats();
        }
    },

    // Calculate sponsor stats from local data
    calculateLocalSponsorStats: function() {
        const users = window.adminData.users || [];
        const transactions = window.adminData.transactions || [];
        
        const usersWithSponsor = users.filter(u => u.sponsorId && u.sponsorId !== 'none' && u.sponsorId !== '');
        const uniqueSponsors = [...new Set(usersWithSponsor.map(u => u.sponsorId))];
        
        const commissionEarnings = transactions
            .filter(tx => tx.category === 'referral' && tx.type === 'earning')
            .reduce((sum, tx) => sum + (tx.amount || 0), 0);
        
        window.adminData.sponsorStats = {
            totalSponsors: uniqueSponsors.length,
            sponsoredUsers: usersWithSponsor.length,
            commissionEarnings: commissionEarnings,
            sponsorConversionRate: users.length > 0 ? ((usersWithSponsor.length / users.length) * 100).toFixed(1) : 0,
            topSponsors: this.getTopSponsors(users),
            lastCalculated: new Date().toISOString()
        };
    },

    // Get top sponsors from user data
    getTopSponsors: function(users) {
        const sponsorMap = {};
        
        users.forEach(user => {
            if (user.sponsorId && user.sponsorId !== 'none' && user.sponsorId !== '') {
                sponsorMap[user.sponsorId] = (sponsorMap[user.sponsorId] || 0) + 1;
            }
        });
        
        return Object.entries(sponsorMap)
            .map(([sponsorId, count]) => ({
                sponsorId,
                referrals: count,
                sponsorData: users.find(u => u.email === sponsorId || u.id === sponsorId)
            }))
            .sort((a, b) => b.referrals - a.referrals)
            .slice(0, 10);
    },

    // Load from localStorage as fallback
    loadFromLocalStorage: function() {
        try {
            const registeredUsers = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
            const allTransactions = JSON.parse(localStorage.getItem('allUsersTransactions') || '[]');
            
            window.adminData = {
                users: registeredUsers,
                transactions: allTransactions,
                lastUpdated: new Date(),
                serverConnected: false
            };
            
            console.log(`⚠️ Loaded ${registeredUsers.length} users from localStorage`);
            
            // Calculate sponsor stats from local data
            this.calculateLocalSponsorStats();
            
            // Calculate mobile users from local data
            this.calculateMobileUsersFromLocal();
            
            this.dispatchEvent('adminDataLoaded', window.adminData);
        } catch (error) {
            console.error('❌ Failed to load any data:', error);
            window.adminData = {
                users: [],
                transactions: [],
                lastUpdated: new Date(),
                serverConnected: false
            };
        }
    },

    // Setup optimized real-time updates
    setupOptimizedRealTimeUpdates: function() {
        // Auto-refresh every 30 seconds if enabled
        this.startAutoRefresh();
        
        // Optimized storage events with debouncing
        let userChangeCount = 0;
        window.addEventListener('storage', (event) => {
            if (event.key === 'registeredUsers') {
                userChangeCount++;
                
                // Only refresh if multiple changes occurred
                if (userChangeCount >= 3) {
                    this.loadInitialData();
                    userChangeCount = 0;
                }
            }
        });

        // Window focus with cooldown
        let lastFocusTime = 0;
        window.addEventListener('focus', () => {
            const now = Date.now();
            if (now - lastFocusTime > 10000) { // 10 seconds cooldown
                lastFocusTime = now;
                this.debouncedRefresh();
            }
        });

        // Page visibility
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
                this.debouncedRefresh();
            }
        });

        // Listen for custom events from main app
        window.addEventListener('userRegistered', () => {
            this.loadInitialData();
        });

        window.addEventListener('transactionAdded', () => {
            this.loadInitialData();
        });
        
        // Listen for sponsor-related events
        window.addEventListener('sponsorAssigned', (event) => {
            console.log('🔄 Sponsor assigned event:', event.detail);
            this.loadSponsorStats();
        });
        
        window.addEventListener('sponsorRemoved', (event) => {
            console.log('🔄 Sponsor removed event:', event.detail);
            this.loadSponsorStats();
        });
        
        // Listen for manual refresh requests
        window.addEventListener('manualRefreshRequest', () => {
            this.loadInitialData();
        });
        
        // Listen for mobile user events
        window.addEventListener('mobileUserRegistered', () => {
            this.updateMobileUserCount();
            this.loadMobileUsersData();
        });
    },
    
    // Setup mobile user listener
    setupMobileUserListener: function() {
        // Listen for mobile-specific events
        window.addEventListener('mobileSyncComplete', (event) => {
            console.log('📱 Mobile sync complete:', event.detail);
            this.updateMobileUserCount();
        });
        
        // Periodic mobile sync
        setInterval(() => {
            if (document.visibilityState === 'visible' && this.autoRefreshEnabled) {
                this.updateMobileUserCount();
            }
        }, 30000);
    },
    
    // Debounce helper
    debouncedRefresh: this.debounce(function() {
        if (document.visibilityState === 'visible') {
            this.loadInitialData();
        }
    }, 2000),
    
    // Debounce function
    debounce: function(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    },
    
    // Start auto-refresh
    startAutoRefresh: function() {
        if (this.refreshTimer) {
            clearInterval(this.refreshTimer);
        }
        
        this.refreshTimer = setInterval(async () => {
            if (this.autoRefreshEnabled && document.visibilityState === 'visible') {
                console.log('🔄 Auto-refresh triggered');
                await this.loadInitialData();
                this.dispatchEvent('adminDataUpdated', window.adminData);
            }
        }, this.refreshInterval);
        
        console.log('✅ Auto-refresh started (30s interval)');
    },
    
    // Stop auto-refresh
    stopAutoRefresh: function() {
        if (this.refreshTimer) {
            clearInterval(this.refreshTimer);
            this.refreshTimer = null;
            console.log('⏸️ Auto-refresh stopped');
        }
    },
    
    // Toggle auto-refresh
    toggleAutoRefresh: function() {
        this.autoRefreshEnabled = !this.autoRefreshEnabled;
        
        if (this.autoRefreshEnabled) {
            this.startAutoRefresh();
            this.showNotification('✅ Auto-refresh enabled', 'success');
        } else {
            this.stopAutoRefresh();
            this.showNotification('⏸️ Auto-refresh disabled', 'warning');
        }
        
        return this.autoRefreshEnabled;
    },

    // Initialize sponsor system
    initializeSponsorSystem: function() {
        console.log('🤝 Initializing Sponsor System...');
        
        // Setup sponsor commission settings if not exists
        if (!localStorage.getItem('sponsorCommissionSettings')) {
            const defaultSettings = {
                level1: 10,
                level2: 5,
                level3: 2,
                minCommission: 100,
                payoutSchedule: 'daily',
                maxDaily: 10000,
                createdAt: new Date().toISOString()
            };
            localStorage.setItem('sponsorCommissionSettings', JSON.stringify(defaultSettings));
        }
        
        // Setup sponsor change log if not exists
        if (!localStorage.getItem('sponsorChangeLog')) {
            localStorage.setItem('sponsorChangeLog', JSON.stringify([]));
        }
        
        console.log('✅ Sponsor System Initialized');
    },

    // Inject admin controls into main app
    injectAdminControls: function() {
        // Check if admin button already exists
        if (document.querySelector('.admin-panel-btn')) return;

        // Create admin panel button
        const adminBtn = document.createElement('button');
        adminBtn.className = 'admin-panel-btn';
        adminBtn.innerHTML = '🛠️ Admin';
        adminBtn.style.cssText = `
            position: fixed;
            top: 70px;
            right: 15px;
            z-index: 9999;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.5);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        `;

        adminBtn.onclick = () => {
            window.open('admin.html', '_blank');
        };

        adminBtn.onmouseenter = () => {
            adminBtn.style.transform = 'translateY(-2px)';
            adminBtn.style.boxShadow = '0 6px 20px rgba(102, 126, 234, 0.7)';
        };

        adminBtn.onmouseleave = () => {
            adminBtn.style.transform = 'translateY(0)';
            adminBtn.style.boxShadow = '0 4px 15px rgba(102, 126, 234, 0.5)';
        };

        document.body.appendChild(adminBtn);
        console.log('✅ Admin panel button injected');
    },

