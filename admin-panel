    // ✅ Sync from all servers
    syncFromAllServers: async function() {
        this.showNotification('🔄 Syncing from all servers...', 'info');
        
        const allUsers = [];
        const allTransactions = [];
        const successfulServers = [];
        
        for (const server of this.servers) {
            try {
                console.log(`🔄 Attempting to sync from ${server.name}: ${server.url}`);
                
                // Try to get users from this server
                const usersResponse = await fetch(`${server.url}/api/get-all-users`, {
                    mode: 'cors',
                    cache: 'no-cache'
                }).catch(() => null);
                
                if (usersResponse && usersResponse.ok) {
                    const data = await usersResponse.json();
                    if (data.success) {
                        const users = data.users || data.data || [];
                        console.log(`✅ Got ${users.length} users from ${server.name}`);
                        
                        // Merge users (avoid duplicates by email or id)
                        users.forEach(user => {
                            const existingIndex = allUsers.findIndex(u => 
                                u.email === user.email || u.id === user.id
                            );
                            
                            if (existingIndex === -1) {
                                allUsers.push(user);
                            } else {
                                // Update existing user with newer data
                                const existingUser = allUsers[existingIndex];
                                if (user.updatedAt > existingUser.updatedAt) {
                                    allUsers[existingIndex] = user;
                                }
                            }
                        });
                        
                        // Try to get transactions
                        const txResponse = await fetch(`${server.url}/api/get-all-transactions`, {
                            mode: 'cors',
                            cache: 'no-cache'
                        }).catch(() => null);
                        
                        if (txResponse && txResponse.ok) {
                            const txData = await txResponse.json();
                            if (txData.success) {
                                const transactions = txData.transactions || txData.data || [];
                                
                                // Merge transactions (avoid duplicates by transactionId)
                                transactions.forEach(transaction => {
                                    const existingIndex = allTransactions.findIndex(t => 
                                        t.transactionId === transaction.transactionId
                                    );
                                    
                                    if (existingIndex === -1) {
                                        allTransactions.push(transaction);
                                    }
                                });
                            }
                        }
                        
                        successfulServers.push(server.name);
                    }
                }
            } catch (error) {
                console.error(`❌ Error syncing from ${server.name}:`, error);
            }
        }
        
        // Filter deleted users
        const filteredUsers = this.filterDeletedUsers(allUsers);
        
        // Update window data
        window.adminData = window.adminData || {};
        window.adminData.users = filteredUsers;
        window.adminData.transactions = allTransactions;
        window.adminData.lastUpdated = new Date();
        window.adminData.multiServerSync = true;
        
        // Update localStorage
        localStorage.setItem('registeredUsers', JSON.stringify(filteredUsers));
        localStorage.setItem('allUsersTransactions', JSON.stringify(allTransactions));
        
        // Dispatch event
        this.dispatchEvent('multiServerSyncComplete', { 
            servers: successfulServers, 
            userCount: filteredUsers.length,
            transactionCount: allTransactions.length 
        });
        
        this.showNotification(
            `✅ Synced from ${successfulServers.length} server(s): ${filteredUsers.length} users, ${allTransactions.length} transactions`,
            'success'
        );
        
        return {
            success: true,
            servers: successfulServers,
            userCount: filteredUsers.length,
            transactionCount: allTransactions.length
        };
    },
    
